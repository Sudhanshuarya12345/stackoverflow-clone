# =====================================================================================
#  Environment variables
#  Backend (server/.env locally, Render -> Environment in production) unless marked FRONTEND.
#
#  [REQUIRED]           the app or a core feature breaks without it
#  [REQUIRED FOR ...]   only that feature stops working without it
#  [OPTIONAL]           has a sensible default (shown after "default:")
# =====================================================================================


# ---------- Core server ----------
# [REQUIRED] MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URL=
# [REQUIRED] Long random string used to sign login tokens. Changing it logs everyone out.
JWT_SECRET=
# [OPTIONAL] default: 5000. Render sets this automatically - leave it unset there.
PORT=
# [OPTIONAL] Set to "production" on Render. Disables the dev-only OTP console fallback.
NODE_ENV=production
# [OPTIONAL] Comma-separated frontend URLs allowed to call the API, e.g. https://your-app.vercel.app
# default: empty = any origin allowed
CORS_ORIGINS=
# [OPTIONAL] Timezone whose midnight resets every daily limit (questions, forgot password, reputation transfers)
# default: Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata


# ---------- FRONTEND (stack/.env locally, Vercel -> Environment Variables) ----------
# [REQUIRED] Backend URL, e.g. https://your-api.onrender.com (no trailing slash).
# It is built into the frontend: redeploy on Vercel after changing it.
BACKEND_URL=http://localhost:5000


# ---------- Admin / moderation (Community Feed + Login Security) ----------
# [REQUIRED FOR admin features] Comma-separated emails that become administrators after their first
# OTP-verified login. Admins review reports, remove posts, suspend users and see all login activity logs.
ADMIN_EMAILS=
# [OPTIONAL] Number of admin content removals after which a user is suspended automatically. default: 3
AUTO_SUSPEND_AFTER_REMOVALS=3


# ---------- Subscriptions & Premium Membership (Razorpay) ----------
# [REQUIRED FOR subscriptions] API keys from Razorpay Dashboard -> Account & Settings -> API Keys.
# Use test-mode keys (rzp_test_...) for the demo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# [REQUIRED FOR subscriptions] Must exactly match the secret of the Razorpay webhook pointing at
#   https://<your-backend>/api/webhooks/razorpay
# Events: subscription.authenticated, subscription.activated, subscription.charged, subscription.cancelled,
#         subscription.halted, subscription.completed, payment.failed
RAZORPAY_WEBHOOK_SECRET=
# [REQUIRED FOR subscriptions] Plan ids (plan_...) created in Razorpay -> Subscriptions -> Plans.
# Monthly amounts must be exactly INR 99 / 299 / 999, or payments are rejected as a mismatch.
RAZORPAY_PLAN_ID_BRONZE=
RAZORPAY_PLAN_ID_SILVER=
RAZORPAY_PLAN_ID_GOLD=


# ---------- Email (login OTP, new-device alerts, French language OTP, password reset, invoices) ----------
# [REQUIRED] Configure ONE of the three options below. Without email, login from a new device fails.
# Order used: BREVO_API_KEY -> RESEND_API_KEY -> SMTP.
#
# [REQUIRED for Brevo/Resend] Sender address; with Brevo it must be a verified sender (Brevo -> Senders).
# With SMTP it defaults to SMTP_USER.
EMAIL_FROM=
# [OPTIONAL] Sender display name. default: StackOverflow Clone
EMAIL_FROM_NAME=StackOverflow Clone

# Option A (recommended, works on Render free plan): Brevo HTTPS API
# Brevo -> SMTP & API -> API Keys. Also turn OFF Brevo -> Security -> Authorised IPs (Render's IPs change).
BREVO_API_KEY=

# Option B: Resend HTTPS API. Free tier only delivers to your own address unless you verify a domain.
RESEND_API_KEY=

# Option C: SMTP. Used only when neither API key above is set.
# Render's free plan blocks ports 25/465/587, so use port 2525 there (e.g. smtp-relay.brevo.com:2525).
# Gmail (smtp.gmail.com:587 with an App Password) works locally but not on Render free.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=


# ---------- SMS (OTP when switching to English/Spanish/Hindi/Portuguese/Chinese, phone password reset) ----------
# [REQUIRED FOR SMS features] Provider: "2factor" (recommended for India: free trial credits, numeric OTP) or "twilio"
# default: twilio
SMS_PROVIDER=2factor
# [REQUIRED IF SMS_PROVIDER=2factor] API key from 2factor.in
TWOFACTOR_API_KEY=
# [OPTIONAL] 2Factor OTP template name. default: 2Factor's standard OTP template
TWOFACTOR_TEMPLATE=
# [REQUIRED IF SMS_PROVIDER=twilio] Twilio trial accounts can only text numbers verified in Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# [OPTIONAL] Country code added to 10-digit phone numbers. default: 91
DEFAULT_PHONE_COUNTRY_CODE=91


# ---------- Login Security & Device Management ----------
# [OPTIONAL] "false" skips the new-device email OTP (local testing only - not for the demo). default: true
LOGIN_OTP_ENABLED=true
# [OPTIONAL] "false" disables looking up the login location from the IP address. default: true
LOGIN_GEOLOCATION=true
# [OPTIONAL] Minutes of inactivity before a session expires automatically. default: 60
SESSION_INACTIVITY_MINUTES=60
# [OPTIONAL] Maximum session lifetime in minutes, even when active. default: 10080 (7 days)
SESSION_MAX_AGE_MINUTES=10080
# [OPTIONAL] Days a "remember this device" choice skips the OTP. default: 30
TRUSTED_DEVICE_DAYS=30
# [OPTIONAL] Local development only (ignored when NODE_ENV=production): print OTP codes to the server
# console when email/SMS delivery fails. default: false
OTP_DEV_LOG=false


# ---------- Forgot Password ----------
# [OPTIONAL] Allowed reset requests per user per day. The assignment requires 1. default: 1
FORGOT_PASSWORD_DAILY_LIMIT=1


# ---------- Community Feed images (Cloudinary) ----------
# [REQUIRED FOR image posts] From the Cloudinary dashboard. Text and code posts work without it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---------- Demo data script (server/scripts/qaSeedData.js) - local use only ----------
# [OPTIONAL] Backend to seed. default: http://localhost:5000
QA_SEED_BASE_URL=
# [OPTIONAL] defaults: 150 users, 1050 questions, 15 parallel requests
QA_SEED_USERS=
QA_SEED_QUESTIONS=
QA_SEED_CONCURRENCY=
